    <div class="col-md-4"><a class="btn btn-outline-primary w-100" asp-page="/PublisherPages/Index">Publishers</a></div>
    <div class="col-md-4"><a class="btn btn-outline-primary w-100" asp-page="/CategoryPages/Index">Categories</a></div>
    <div class="col-md-4"><a class="btn btn-outline-primary w-100" asp-page="/MemberPages/Index">Members</a></div>
    <div class="col-md-4"><a class="btn btn-outline-primary w-100" asp-page="/BorrowingPages/Index">Borrowings</a></div>
